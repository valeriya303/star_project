{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-journal-entry.schema.json",
  "title": "Запис журналу спостережень",
  "description": "Схема валідації запису журналу спостережень за зорею.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "star_id": {
      "type": [
        "integer",
        "string"
      ],
      "description": "Ідентифікатор зорі, що має існувати в каталозі; перевіряється бекендом."
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "brightness_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "conditions_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "observer_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "observer_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  "required": [
    "observation_id",
    "star_id",
    "observed_at",
    "brightness_rating",
    "conditions_rating"
  ]
}